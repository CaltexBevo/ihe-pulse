# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mailchimp Newsletter (required for /api/newsletter)
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_AUDIENCE_ID=your-audience-id
MAILCHIMP_SERVER_PREFIX=us16

# Cloudflare Turnstile (required for newsletter signup)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Production rollout is exact www.innovatinghighered.com only.
# Preview is intentionally unset and disabled. Any future addition must be exact; wildcards are rejected.
NEWSLETTER_ALLOWED_ORIGINS=https://www.innovatinghighered.com
TURNSTILE_ALLOWED_HOSTNAMES=www.innovatinghighered.com

# ElevenLabs (required for scripts/generate-audio.mjs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Full newsletter sharing: staged; unset/false fails closed. No accounts provisioned.
NEWSLETTER_SHARE_ENABLED=false
NEWSLETTER_SHARE_PROVIDER=resend
# Choose one provider's separate server-only sending credential:
RESEND_API_KEY=your-sending-only-api-key
# MANDRILL_API_KEY=your-transactional-api-key
NEWSLETTER_SHARE_REDIS_URL=https://your-dedicated-database.upstash.io
NEWSLETTER_SHARE_REDIS_TOKEN=your-server-only-rest-token
NEWSLETTER_SHARE_HMAC_KEY=your-stable-random-secret-at-least-32-characters
# Preserve HMAC/suppression/attempt state across deployments; see docs/newsletter-share/SETUP.md.
